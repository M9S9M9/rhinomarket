{
  "name": "rhino-marketplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma db push --accept-data-loss; prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:use-sqlite": "copy /Y prisma\\schema.sqlite.prisma prisma\\schema.prisma",
    "db:use-postgres": "copy /Y prisma\\schema.postgres.prisma prisma\\schema.prisma",
    "setup:sqlite": "npm run db:use-sqlite && npm run db:generate && npm run db:push && npm run db:seed",
    "go": "npm run db:use-sqlite && npm run db:generate && npm run db:push && npm run db:seed && npm run dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@prisma/client": "^6.0.0",
    "@stripe/stripe-js": "^5.0.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "date-fns": "^4.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.400.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.0.0",
    "typescript": "^5"
  }
}
