# ── Database (PostgreSQL) ──
# Get a free database at https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Next Auth ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-at-least-32-chars-long"
AUTH_URL="https://your-domain.vercel.app"

# ── Coinbase Commerce ──
# Get API keys at https://commerce.coinbase.com/dashboard/settings
COINBASE_COMMERCE_API_KEY="your-api-key"
COINBASE_COMMERCE_WEBHOOK_SECRET="your-webhook-secret"

# ── Email (Resend) ──
# Get free API key at https://resend.com
RESEND_API_KEY="re_..."
EMAIL_DOMAIN="your-domain.com"

# ── File Storage (Cloudflare R2 / AWS S3) ──
# Skip these to use local filesystem (dev only)
S3_ENDPOINT="https://account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="rhinomarket"
S3_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ── Platform ──
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_NAME="RhinoMarket"
PLATFORM_NAME="RhinoMarket"
PLATFORM_COMMISSION_PERCENT=15
PLATFORM_EMAIL="hello@your-domain.com"

# ── Upload ──
UPLOAD_MAX_FILE_SIZE_MB=500
ALLOWED_FILE_TYPES=".3dm"

# ── USDT BSC Auto-Payment ──
# Get free API key at https://bscscan.com/apis
BSCSCAN_API_KEY="your-bscscan-api-key"
# Public JSON-RPC endpoint for BNB Smart Chain (optional, has defaults)
BSC_RPC_URL="https://bsc-dataseed.binance.org"
# Private key for the platform USDT (BEP-20) wallet (used for auto-payouts to designers)
# WARNING: Keep this secret! Never commit to git. The wallet must hold BNB for gas fees.
PLATFORM_WALLET_PRIVATE_KEY="your-platform-wallet-private-key"
# Minimum block confirmations before auto-confirming a payment (default: 12 = ~36s)
MIN_BLOCK_CONFIRMATIONS=12
# Secret token to protect cron endpoints from unauthorized access
CRON_SECRET="your-random-cron-secret"
